# Private profiles never leave this machine; only the public example is tracked.
# scripts/check-public.sh verifies this before every commit/push once
# scripts/install-git-hooks.sh has been run.
profiles/*
!profiles/example/

# Local, per-machine
.claude/settings.local.json
.env
.env.*
.DS_Store

# Orchestrate mode working artifacts (promoted ones are committed elsewhere)
.sdlc/*/work/
